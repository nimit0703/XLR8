# Database connection URL
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://xlr8user:xlr8pass@localhost:5432/xlr8db"

# For Docker (when running migrations from host machine)
# DATABASE_URL="postgresql://xlr8user:xlr8pass@localhost:5432/xlr8db"

# For Docker containers (when services communicate within Docker network)
# DATABASE_URL="postgresql://xlr8user:xlr8pass@postgres:5432/xlr8db"

# ... existing DB url ...

# JWT Secrets (Generate random strings for these in production!)
JWT_ACCESS_SECRET="super_secret_access_key_123"
JWT_REFRESH_SECRET="super_secret_refresh_key_456"

# Expiry Times
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"